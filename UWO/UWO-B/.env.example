# ==============================================================================
# UWO UNIFIED BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your secrets/credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATIONS
# ------------------------------------------------------------------------------
# Primary App Database (Users, Referral System, Products, Orders)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.selr4is.mongodb.net/UWO-web?retryWrites=true&w=majority

# Unified Telemetry & Analytics Database (Marketing Campaigns, Telemetry Logs)
UNIFIED_MONGODB_URI=mongodb+srv://<username>:<password>@unified-dashboard.wisisoq.mongodb.net/?appName=Unified-Dashboard
UNIFIED_MONGODB_DB_NAME=unified_service_db

# Compatibility Aliases for Internal Unified Service Modules
MONGODB_URL=mongodb+srv://<username>:<password>@unified-dashboard.wisisoq.mongodb.net/?appName=Unified-Dashboard
MONGODB_DB_NAME=unified_service_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
REFERRAL_JWT_SECRET=your_referral_jwt_secret_key_here

# Admin Portal Default Credentials
ADMIN_EMAIL=admin@uwo.com
ADMIN_PASSWORD=your_admin_password_here

# ------------------------------------------------------------------------------
# 4. DOMAINS, REDIRECTION & ROUTING
# ------------------------------------------------------------------------------
# Short Link Base URL for all /r/:code redirection endpoints
SHORT_LINK_BASE_URL=https://uwo24.com
REFERRAL_BASE_URL=https://uwo24.com

# User Referral Dashboard Frontend URL
REFERRAL_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://uwo24.com

# Custom Subdomain Short Links
AI_LEGAL_SHORT_LINK_BASE_URL=https://ailegal.aisa24.com
AISA_SHORT_LINK_BASE_URL=https://aisa24.com

# ------------------------------------------------------------------------------
# 5. MOBILE APP STORE ATTRIBUTION & IDENTIFIERS
# ------------------------------------------------------------------------------
# AISA Assistant App
AISA_APPLE_APP_ID=6779135418
AISA_BUNDLE_ID=com.uwo.aisa

# AI Legal Advocate Suite
AI_LEGAL_APPLE_APP_ID=6797449251
AI_LEGAL_BUNDLE_ID=com.uwo.ailegal

# ------------------------------------------------------------------------------
# 6. LIVE APP STORE TELEMETRY ENGINES
# ------------------------------------------------------------------------------
# Google Play Console Reports (Google Cloud Storage Ingestion)
GOOGLE_PLAY_PROJECT_ID=unified-web-options
GOOGLE_PLAY_GCS_BUCKET_ID=pubsite_prod_5002243960657921085
PLAY_STORE_SYNC_INTERVAL_HOURS=24

# Apple App Store Connect API
APP_STORE_CONNECT_ISSUER_ID=your_issuer_uuid_here
APP_STORE_CONNECT_KEY_ID=your_key_id_here
APP_STORE_CONNECT_PRIVATE_KEY_PATH=keys/AuthKey_YOUR_KEY_ID.p8
APP_STORE_CONNECT_VENDOR_NUMBER=your_vendor_number_here

# Firebase Analytics & Google Analytics 4
FIREBASE_PROPERTY_ID=545341929
GA4_PROPERTY_ID=545341929
FIREBASE_SERVICE_ACCOUNT_PATH=keys/firebase-service-account.json

# ------------------------------------------------------------------------------
# 7. GOOGLE CLOUD PLATFORM & ASSET STORAGE
# ------------------------------------------------------------------------------
GOOGLE_PROJECT_ID=unified-web-options
GCP_PROJECT_ID=unified-web-options
GCS_BUCKET_NAME=uwo-document
GOOGLE_LOCATION=asia-south1

# ------------------------------------------------------------------------------
# 8. EMAIL DELIVERY & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Google Workspace / Gmail SMTP
SMTP_ENABLE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=admin@uwo24.com
EMAIL_PASS=your_gmail_app_password
SMTP_FROM="UWO™ Referral Ecosystem" <admin@uwo24.com>

# Resend API
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="UWO™ Referral Ecosystem" <admin@ai-mall.in>

# ------------------------------------------------------------------------------
# 9. PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=affiliate-payment
RAZORPAY_MODE=live

# Cashfree
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_MODE=production
CASHFREE_BASE_URL=https://api.cashfree.com


# ------------------------------------------------------------------------------
# 10. UWO CENTRAL FINANCIAL DATABASE (POSTGRESQL) & WALLET
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres@localhost:5432/uwo_wallet
DATABASE_TEST_URL=postgresql://postgres@localhost:5432/uwo_wallet_test
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=uwo_wallet
PGPASSWORD=
WALLET_SERVICE_SECRET=your_wallet_internal_service_secret_here
